# ─────────────────────────────────────────────
# ALGO-BOT Environment Variables
# Iss file ko .env naam se save karo
# ─────────────────────────────────────────────

# Telegram Bot Token (BotFather se milega)
BOT_TOKEN=your_telegram_bot_token_here

# Gemini AI API Key (Google AI Studio se milega)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Telegram User IDs (comma separated)
# Apna Telegram User ID find karne ke liye @userinfobot se puchho
ADMIN_IDS=123456789,987654321
